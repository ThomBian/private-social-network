// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostSize {
  rectangle
  square
}

model User {
  id          String   @id @default(uuid())
  username    String?  @unique
  email       String?  @unique
  phoneNumber String   @unique
  createdAt   DateTime @default(now())

  profile Profile?
  posts   Post[]

  myConnections   Connection[] @relation("myConnections")
  connectedToMe  Connection[] @relation("connectedToMe")
}

model Profile {
  id     String @id @default(uuid())
  bio    String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

enum PostAudience {
  FAMILY
  FRIENDS
  ALL
}

model Post {
  id        String   @id @default(uuid())
  caption   String
  post_date DateTime @default(now())
  img       String
  size      PostSize @default(rectangle)
  type      String   @default("image")

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  audience PostAudience @default(FAMILY)
}

enum RelationGroup {
  FAMILY
  FRIENDS
  OTHERS
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}
model Connection {
  id String @id @default(uuid())

  owner User @relation("myConnections", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  viewer User @relation("connectedToMe", fields: [viewerId], references: [id], onDelete: Cascade)
  viewerId String

  group RelationGroup @default(OTHERS)

  status ConnectionStatus @default(PENDING)

  @@unique([ownerId, viewerId])
  @@index([viewerId, status, group])
}
